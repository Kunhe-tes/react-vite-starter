{
  "name": "react-vite-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0",
    "npm": ">=9.8.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.25.0",
    "less": "^4.5.1",
    "prettier": "3.0.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "6.4.5"
  },
  "overrides": {
    "rollup": "4.65.1"
  }
}
